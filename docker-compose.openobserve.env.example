#@ Placement
#-    Placement constraint for OpenObserve and bundled Dex.
#-    Examples:
#-        - node.hostname==<hostname>
#-        - engine.labels.fs-access.<worker-hostname>.mnt==true
#-        - node.role!=manager
PLACEMENT_CONSTRAINT=engine.labels.node-type==swarm-monitor
#-  - POSTGRES_PLACEMENT_CONSTRAINT -
#-    Place Postgres on the node that holds POSTGRES_DATA_PATH. Configure separately from PLACEMENT_CONSTRAINT.
POSTGRES_PLACEMENT_CONSTRAINT=engine.labels.node-type==swarm-monitor
#@ Traefik Config
#-  - TRAEFIK_ROUTER_ENABLED -
#-    Set true to enable Traefik routing for OpenObserve and the embedded Dex service.
#-    Requires Traefik on swarm-public with the web entrypoint.
#-    Bundled Dex also requires DEX_ENABLED=true and public HTTPS at TRAEFIK_DOMAIN.
#-    Set false to disable both Traefik routes; published host ports remain accessible.
TRAEFIK_ROUTER_ENABLED=false
#-  - TRAEFIK_DOMAIN -
#-    Hostname for Traefik routing; bundled Dex uses this public HTTPS hostname.
TRAEFIK_DOMAIN=openobserve.local
#-  - TRAEFIK_ROUTER_MIDDLEWARES -
#-    Optional comma separated middleware names for the OpenObserve router; empty applies none.
#-    Suggestions: 
#-        - compress (Compress) for response compression
#-        - security-headers (Headers) for security headers;
#-        - ip-allowlist (IPAllowList) to restrict access to trusted user and log collector networks.
#-    Ensure you define the selected middleware in Traefik before referencing it here.
#-    Example: compress,security-headers
TRAEFIK_ROUTER_MIDDLEWARES=
#@ Host Config
#-  - TZ -
#-    The timezone.
TZ=Etc/UTC
#-  - PUID -
#-    User to run services as.
PUID=1000
#-  - PGID -
#-    Group to run services as.
PGID=1000
#@ Resource Limits
#-  - OPENOBSERVE_MEMLIMIT -
#-    Limit OpenObserve container memory.
OPENOBSERVE_MEMLIMIT=4g
#-  - POSTGRES_MEMLIMIT -
#-    Limit Postgres container memory.
POSTGRES_MEMLIMIT=1g
#@ Container Paths
#-  - OPENOBSERVE_DATA_PATH -
#-    The path to the OpenObserve data directory (WAL, cache, local DB).
OPENOBSERVE_DATA_PATH=./appdata/openobserve
#-  - POSTGRES_DATA_PATH -
#-    Persistent Postgres data directory on the selected node.
POSTGRES_DATA_PATH=./appdata/postgres
#@ Ports
#-  - OPENOBSERVE_HTTP_PUBLISHED_PORT -
#-    OpenObserve HTTP port published to the host (default: 5080).
#-    The container and Traefik backend always use port 5080; this setting changes only the host port.
#-    The host port remains accessible when TRAEFIK_ROUTER_ENABLED=false.
OPENOBSERVE_HTTP_PUBLISHED_PORT=5080
#-  - OPENOBSERVE_GRPC_PUBLISHED_PORT -
#-    OpenObserve gRPC port published to the host.
OPENOBSERVE_GRPC_PUBLISHED_PORT=5081
#-  - POSTGRES_PUBLISHED_PORT -
#-    Postgres port published to the host for administration; OpenObserve uses private-net port 5432.
POSTGRES_PUBLISHED_PORT=5432
#@ OpenObserve Admin
#-  - ZO_ROOT_USER_EMAIL -
#-    Root user email.
ZO_ROOT_USER_EMAIL=admin@example.com
#-  - ZO_ROOT_USER_PASSWORD -
#-    Root user password.
ZO_ROOT_USER_PASSWORD=ChangeMe123!
#@ OpenObserve Schema & Ingestion Settings
#-  - ZO_ALLOW_USER_DEFINED_SCHEMAS -
#-    If true, allows users to define schemas for streams.
ZO_ALLOW_USER_DEFINED_SCHEMAS=false
#-  - ZO_INGEST_ALLOWED_UPTO -
#-    Maximum age in hours of historical data allowed for ingestion (default: 5).
#-    Examples:
#-        - 24   (1 day)
#-        - 72   (3 days)
#-        - 168  (1 week)
#-        - 336  (2 weeks)
ZO_INGEST_ALLOWED_UPTO=5
#@ OpenObserve Storage Mode & Role
#-  - ZO_LOCAL_MODE -
#-    true for single-node; set false for cluster mode.
ZO_LOCAL_MODE=true
#-  - ZO_NODE_ROLE -
#-    Set OpenObserve node role: all | compact | querier | ingester | compactor.
ZO_NODE_ROLE=all
#-  - ZO_LOCAL_MODE_STORAGE -
#-    disk or s3. If using MinIO/S3 set to s3. With s3, stream data goes to object storage and local disk holds WAL/cache.
ZO_LOCAL_MODE_STORAGE=s3
#@ OpenObserve Object Storage
#-  - ZO_S3_PROVIDER -
#-    Storage provider. Use 'minio' for MinIO (default), 'aws' for AWS S3, or 'azure' for Azure Blob.
ZO_S3_PROVIDER=minio
#-  - ZO_S3_BUCKET_NAME -
#-    Bucket or container name used for OpenObserve data.
ZO_S3_BUCKET_NAME=openobserve-data
#-  - ZO_S3_SERVER_URL -
#-    Object storage endpoint URL; leave unset or empty for AWS S3 and Azure Blob (default: empty).
#-    For MinIO, set the MinIO S3 API URL, e.g. http://minio:9000 on swarm-public.
#-    Use http://<minio-stack>_minio:9000 for a separately deployed service, or its reachable API URL.
#-    Use the S3 API endpoint, not the MinIO console URL.
ZO_S3_SERVER_URL=
#-  - ZO_S3_REGION_NAME -
#-    MinIO region; match the region configured on the MinIO server (normally us-east-1).
#-    For AWS S3, use the region containing the bucket, e.g. us-west-1. Optional for Azure Blob.
ZO_S3_REGION_NAME=us-east-1
#-  - ZO_S3_ACCESS_KEY -
#-    MinIO access key for a user or service account with access to the OpenObserve bucket.
#-    For AWS S3, use the IAM access key ID associated with the bucket access policy.
ZO_S3_ACCESS_KEY=openobserve
#-  - ZO_S3_SECRET_KEY -
#-    MinIO secret key paired with ZO_S3_ACCESS_KEY. Replace the example before deploying.
#-    For AWS S3, use the secret access key paired with the IAM access key ID.
ZO_S3_SECRET_KEY=supersecret
#-  - ZO_S3_BUCKET_PREFIX -
#-    Optional prefix, e.g. openobserve/
ZO_S3_BUCKET_PREFIX=
#-  - AZURE_STORAGE_ACCOUNT_NAME -
#-    Azure storage account name. Required when ZO_S3_PROVIDER=azure.
#-    Clear ZO_S3_ACCESS_KEY and ZO_S3_SECRET_KEY when using the AZURE_STORAGE_* credentials.
AZURE_STORAGE_ACCOUNT_NAME=
#-  - AZURE_STORAGE_ACCOUNT_KEY -
#-    Azure storage account access key. Required when ZO_S3_PROVIDER=azure.
AZURE_STORAGE_ACCOUNT_KEY=
#@ OpenObserve Metadata Store
#-    Deployment options:
#-      SQLite (default): ZO_META_STORE=sqlite, POSTGRES_REPLICAS=0, ZO_META_POSTGRES_DSN empty.
#-      Stack Postgres: ZO_META_STORE=postgres, POSTGRES_REPLICAS=1, and set POSTGRES_PASSWORD.
#-        Set ZO_META_POSTGRES_DSN=postgres://openobserve:<password>@postgres:5432/openobserve.
#-        Match the DSN username/database to POSTGRES_USER/POSTGRES_DB and prepare POSTGRES_DATA_PATH.
#-      External Postgres: ZO_META_STORE=postgres, POSTGRES_REPLICAS=0, and set ZO_META_POSTGRES_DSN
#-        to the external database URL reachable from OpenObserve; bundled Postgres settings are unused.
#-  - ZO_META_STORE -
#-    Metadata store backend. sqlite (local) or postgres (recommended).
ZO_META_STORE=sqlite
#-  - ZO_META_POSTGRES_DSN -
#-    Leave empty for SQLite. For Postgres, supply the bundled or external database connection URL.
#-    URL-encode reserved characters in the DSN username and password.
ZO_META_POSTGRES_DSN=
#@ Postgres Config
#-  - POSTGRES_REPLICAS -
#-    Bundled Postgres containers: 0 for SQLite or external Postgres (default), 1 for stack Postgres.
POSTGRES_REPLICAS=0
#-  - POSTGRES_USER -
#-    Postgres user created when the data directory is first initialised.
POSTGRES_USER=openobserve
#-  - POSTGRES_PASSWORD -
#-    Required when POSTGRES_REPLICAS=1. Set a password and use it in ZO_META_POSTGRES_DSN.
#-    Leave empty when bundled Postgres is disabled.
POSTGRES_PASSWORD=
#-  - POSTGRES_DB -
#-    Database created for OpenObserve metadata on first initialisation.
POSTGRES_DB=openobserve
#@ Enterprise Dex (OIDC)
#-    SSO requires O2_DEX_BASE_URL, O2_CALLBACK_URL and O2_DEX_REDIRECT_URL.
#-  - O2_DEX_BASE_URL -
#-    Required for SSO: full Dex issuer URL, e.g. https://auth.example.com/dex.
#-    Bundled Dex issuer: https://<TRAEFIK_DOMAIN>/dex. For external Dex, use its issuer URL.
O2_DEX_BASE_URL=
#-  - O2_CALLBACK_URL -
#-    Required for SSO: OpenObserve browser callback, https://<OpenObserve hostname>/web/cb.
#-    Set explicitly; this URL is independent of the Dex issuer hostname.
O2_CALLBACK_URL=
#-  - O2_DEX_REDIRECT_URL -
#-    Required for SSO: https://<OpenObserve hostname>/config/redirect.
#-    Must match the redirect URI registered in Dex; used by the bundled Dex static client.
O2_DEX_REDIRECT_URL=
#-  - O2_DEX_SCOPES -
#-    Scopes requested from Dex for SSO.
#-    NOTE: Add 'groups' only for intentional group-based organisation mapping.
#-    Group claims can affect organisation membership when group mapping is configured.
O2_DEX_SCOPES=openid profile email offline_access
#-  - O2_DEX_GROUP_ATTRIBUTE -
#-    Maps user to OpenObserve organization.
O2_DEX_GROUP_ATTRIBUTE=groups
#-  - O2_DEX_ROLE_ATTRIBUTE -
#-    User's role in the organization.
O2_DEX_ROLE_ATTRIBUTE=cn
#-  - O2_DEX_DEFAULT_ORG -
#-    Default organization for users not belonging to any group in ldap.
O2_DEX_DEFAULT_ORG=default
#-  - O2_DEX_TOKEN_EP_SUFFIX -
#-    Suffix for dex token endpoint.
O2_DEX_TOKEN_EP_SUFFIX=/token
#-  - O2_DEX_KEYS_EP_SUFFIX -
#-    Suffix for dex keys endpoint.
O2_DEX_KEYS_EP_SUFFIX=/keys
#-  - O2_DEX_AUTH_EP_SUFFIX -
#-    Suffix for dex authentication endpoint.
O2_DEX_AUTH_EP_SUFFIX=/auth
#-  - O2_DEX_NATIVE_LOGIN_ENABLED -
#-    Indicates if native dex login is enabled.
O2_DEX_NATIVE_LOGIN_ENABLED=true
#@ Embedded Dex Service
#-  - DEX_ENABLED -
#-    Enables OpenObserve SSO and bundled Dex startup; set DEX_REPLICAS=1 to run bundled Dex.
#-    For external Dex, set DEX_ENABLED=true and DEX_REPLICAS=0, with its client credentials and URLs.
DEX_ENABLED=false
#-  - DEX_REPLICAS -
#-    Number of bundled Dex containers: 0 for external Dex or disabled SSO (default).
#-    Set 1 with DEX_ENABLED=true to run bundled Dex.
DEX_REPLICAS=0
#-  - DEX_CLIENT_ID -
#-    OpenObserve client id registered in bundled or external Dex.
DEX_CLIENT_ID=
#-  - DEX_CLIENT_SECRET -
#-    OpenObserve client secret registered in bundled or external Dex.
DEX_CLIENT_SECRET=
#-  - DEX_HTTP_PORT -
#-    Dex HTTP listener and published host port; use this port for the ALB HTTP target group.
#-    Published in host mode on the Swarm node running Dex; independent of Traefik routing.
DEX_HTTP_PORT=5556
#-  - DEX_GRPC_PORT -
#-    Dex gRPC listener and published host port on the Swarm node running Dex.
DEX_GRPC_PORT=5557
#-  - DEX_CONNECTOR -
#-    Selects one bundled Dex connector: google or gitlab.
DEX_CONNECTOR=google
#-  - DEX_CONNECTOR_CLIENT_ID -
#-    Upstream OIDC client id used by Dex against Google or GitLab.
DEX_CONNECTOR_CLIENT_ID=
#-  - DEX_CONNECTOR_CLIENT_SECRET -
#-    Upstream OIDC client secret used by Dex against Google or GitLab.
DEX_CONNECTOR_CLIENT_SECRET=
#-  - DEX_CONNECTOR_REDIRECT_URI -
#-    Callback URL registered with the Google or GitLab application.
#-    Leave empty to use O2_DEX_BASE_URL followed by /callback.
DEX_CONNECTOR_REDIRECT_URI=
#-  - DEX_CONNECTOR_OIDC_SCOPES -
#-    Upstream scopes for the Google OIDC connector; leave empty for openid profile email.
#-    The GitLab connector selects its required scopes internally and does not accept this setting.
DEX_CONNECTOR_OIDC_SCOPES=
#-  - DEX_CONNECTOR_GROUPS -
#-    Optional space-separated GitLab groups that are allowed to log in through Dex.
#-    Only used when DEX_CONNECTOR=gitlab.
DEX_CONNECTOR_GROUPS=
#-  - GITLAB_BASE_URL -
#-    GitLab base URL, e.g. https://gitlab.com. Only used when DEX_CONNECTOR=gitlab.
GITLAB_BASE_URL=https://gitlab.com
